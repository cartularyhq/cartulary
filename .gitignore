# Local secrets. Only .env.example is committed; .env holds real credentials.
.env

# Build and dependency output, regenerated by mix.
_build/
deps/
erl_crash.dump
*.ez
*.beam

# Editor and language-server state.
.elixir_ls/
.idea/

# Python and Node tooling used by the sdk/ helpers.
__pycache__/
*.py[cod]
node_modules/

# Dialyzer PLTs: large, machine-specific, and rebuildable.
priv/plts/

# Any local SQLite file. Cartulary runs on PostgreSQL in every deployment
# mode; a file here means someone pointed a tool at the wrong adapter.
priv/repo/*.sqlite*

# Compiled asset output is generated at build time. governance.js is the one
# hand-written asset and is deliberately tracked.
priv/static/assets/*
!priv/static/assets/governance.js
priv/static/cache_manifest.json

# The pg0 PostgreSQL binary is downloaded into the release overlay at package
# time and verified against the pinned per-platform checksum. It is never
# committed.
rel/overlays/bin/pg0
rel/overlays/bin/pg0.exe

# Built documentation site. `mkdocs build` regenerates it from docs/; only the
# GitHub Actions Pages job publishes it.
site/
