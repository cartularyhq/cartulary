# SPDX-License-Identifier: Cartulary-Sustainable-Use-1.0
#
# Sobelow (Phoenix security scanner) configuration, read by `mix sobelow
# --config`. Run it for any change touching the web layer, authentication,
# tenancy, or raw SQL.
#
# The posture here is deliberately strict: the scan fails the build on a
# low-confidence finding, and nothing is on a permanent ignore list. If a
# finding is a genuine false positive, suppress it at the call site with a
# `# sobelow_skip ["Finding.Module"]` comment above the function, explaining
# why, so the reason lives next to the code rather than in this file where
# nobody will read it.
[
  # Exit non-zero as soon as a low-or-higher finding appears, so CI blocks.
  exit: :low,
  format: "txt",
  # Empty on purpose. Prefer an explained per-call-site skip over a blanket
  # exclusion — see the note above.
  ignore_files: [],
  ignore: [],
  # nil writes the report to stdout rather than a file.
  out: nil,
  # Skips Sobelow's check for a newer version of itself, so a scan makes no
  # outbound network call.
  private: true,
  # nil lets Sobelow discover the Phoenix router itself.
  router: nil,
  # Honour `# sobelow_skip` annotations in source.
  skip: true,
  # Report everything from low confidence upward.
  threshold: :low,
  verbose: false,
  version: false
]
