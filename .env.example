# SPDX-License-Identifier: Cartulary-Sustainable-Use-1.0

# Local Phoenix server port.
PORT=4000

# Source-development connection. Packaged releases default to supervised pg0
# and generate their own data paths; containers use external Postgres.
DATABASE_URL=ecto://postgres:postgres@localhost:5432/cartulary_dev
POOL_SIZE=10
# CARTULARY_DATABASE_MODE=external
# CARTULARY_AUTO_MIGRATE=false
# CARTULARY_PG0_BINARY=/absolute/path/to/pg0
# CARTULARY_PG0_DATA_DIR=/absolute/path/to/cartulary-pg0-data
# CARTULARY_PG0_PORT=5432
# CARTULARY_PG0_DATABASE=cartulary
# CARTULARY_PG0_USERNAME=postgres
# CARTULARY_PG0_PASSWORD=postgres

# Free-core identity. Generate independent random production secrets; do not
# reuse SECRET_KEY_BASE. The bootstrap password is read only by the one-time
# identity task and need not remain in .env afterward.
CARTULARY_FREE_ACCOUNT_KEY=local
CARTULARY_FREE_ACCOUNT_NAME=Local Cartulary
CARTULARY_AUTH_SIGNING_SECRET=
CARTULARY_BOOTSTRAP_PASSWORD=

# Provider-neutral generation roles. The deterministic provider is an
# explicit test/local fallback only; production defaults local fallback off and
# never selects it after a live provider fails.
CARTULARY_MODEL_PROVIDER=openrouter
CARTULARY_MODEL_LOCAL_FALLBACK=true
CARTULARY_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
CARTULARY_MODEL_VERSION=unversioned
CARTULARY_MODEL_INGEST=openai/gpt-oss-120b
CARTULARY_MODEL_DREAM=openai/gpt-oss-120b
CARTULARY_MODEL_ASK=openai/gpt-oss-120b
# Three settings shared by all three generation roles that keep a reasoning
# model from blowing its context window or getting killed by a short timeout.
# reasoning_effort bounds spend before output is emitted (the primary lever);
# max_tokens is the hard backstop; receive_timeout covers reasoning models
# ReqLLM does not itself recognize as needing a longer default timeout.
CARTULARY_MODEL_REASONING_EFFORT=low
CARTULARY_MODEL_MAX_TOKENS=8192
CARTULARY_MODEL_RECEIVE_TIMEOUT_MS=120000

# Pinned embedding role. Ortex reads local artifacts and performs no download.
# Set absolute paths before invoking the embedder.
CARTULARY_EMBEDDING_PROVIDER=ortex
CARTULARY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CARTULARY_EMBEDDING_VERSION=onnx-1
CARTULARY_EMBEDDING_DIMENSIONS=384
CARTULARY_ORTEX_MODEL_PATH=
CARTULARY_ORTEX_TOKENIZER_PATH=
CARTULARY_ORTEX_POOLING=cls
CARTULARY_ORTEX_EXECUTION_PROVIDERS=cpu

# For an API embedder, set CARTULARY_EMBEDDING_PROVIDER=openai-compatible and
# configure these without persisting the raw key in ModelRoleConfig.
CARTULARY_EMBEDDING_BASE_URL=
CARTULARY_EMBEDDING_API_KEY=

# Budget admission and self-host cost visibility. Limits are daily token
# counters; dream-time is throttled first. Rates are USD per million tokens.
CARTULARY_BUDGET_LIMITS_JSON={"input_tokens":1000000,"output_tokens":250000,"embedding_tokens":2000000}
CARTULARY_MODEL_COSTS_JSON={"ingest_extractor":{"input":0.0,"output":0.0},"dream_reasoner":{"input":0.0,"output":0.0},"dialectic_agent":{"input":0.0,"output":0.0},"embedder":{"embedding":0.0}}

# Document storage, parsing, and chunking. Local blobs are content-addressed
# beneath CARTULARY_BLOB_ROOT. Leave the variable unset to use the environment
# default. For S3, configure ExAws credentials through its standard AWS
# environment in addition to the bucket, prefix, and optional compatible host.
CARTULARY_BLOB_ADAPTER=local
# CARTULARY_BLOB_ROOT=/absolute/path/to/cartulary-blobs
CARTULARY_S3_BUCKET=
CARTULARY_S3_PREFIX=cartulary
# CARTULARY_S3_HOST=localhost
# CARTULARY_S3_SCHEME=http://
# CARTULARY_S3_PORT=9000
# AWS_REGION=us-east-1
CARTULARY_DOCUMENT_CHUNK_SIZE=1200
CARTULARY_DOCUMENT_CHUNK_OVERLAP=160
CARTULARY_DOCUMENT_MAX_EXTRACT_LENGTH=500000

# Development observability. Start the local collector with:
# docker compose -f dev/observability/docker-compose.yml up
CARTULARY_OTEL_ENABLED=false
CARTULARY_ENVIRONMENT=development
OTEL_SERVICE_NAME=cartulary-dev
CARTULARY_EXPERIMENT_NAME=local-dev
CARTULARY_EXPERIMENT_RUN_ID=manual
CARTULARY_RETRIEVAL_VARIANT=poc-baseline
OTEL_EXPORTER_OTLP_PROTOCOL=http_protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Span category controls. Keep HTTP, memory, model, and Oban enabled for normal
# workflow traces. Enable Phoenix/Ecto spans only for deep framework/database
# debugging because they add a lot of low-level spans.
CARTULARY_OTEL_HTTP_SPANS_ENABLED=true
CARTULARY_OTEL_PHOENIX_SPANS_ENABLED=true
CARTULARY_OTEL_MEMORY_SPANS_ENABLED=true

# Declares this whole deployment process has no human governance participant.
# When true, personal knowledge above peer level has its subject consent
# auto-granted instead of blocked pending a real subject. Off by default —
# only set this for a benchmark, evaluation, or synthetic-data deployment.
CARTULARY_GOVERNANCE_UNATTENDED=false
CARTULARY_OTEL_MODEL_SPANS_ENABLED=true
CARTULARY_OTEL_DOCUMENT_SPANS_ENABLED=true
CARTULARY_OTEL_OBAN_SPANS_ENABLED=true
CARTULARY_OTEL_OBAN_SPAN_RELATIONSHIP=child
CARTULARY_OTEL_ECTO_SPANS_ENABLED=false

# Disabled by default because SQL statements can include sensitive values.
CARTULARY_OTEL_DB_STATEMENT_ENABLED=false

# Optional direct-to-Langfuse OTLP config. Prefer the local collector profile
# during development so traces can also be inspected locally.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic <base64-public-key-colon-secret-key>,x-langfuse-ingestion-version=4

# Production-only settings. Not needed for `mix phx.server` in dev.
PHX_HOST=localhost
PHX_SERVER=false
SECRET_KEY_BASE=
DNS_CLUSTER_QUERY=
ECTO_IPV6=false
