# SPDX-License-Identifier: Cartulary-Sustainable-Use-1.0

# Local Phoenix server port.
PORT=4000

# Local pg0/Postgres connection used by the POC.
DATABASE_URL=ecto://postgres:postgres@localhost:5432/cartulary_dev
POOL_SIZE=10

# Optional OpenAI-compatible model endpoint.
# Leave OPENROUTER_API_KEY blank to use the deterministic fallback extractor.
CARTULARY_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
CARTULARY_MODEL_INGEST=openai/gpt-oss-120b
CARTULARY_MODEL_DREAM=openai/gpt-oss-120b
CARTULARY_MODEL_ASK=openai/gpt-oss-120b

# Development observability. Start the local collector with:
# docker compose -f dev/observability/docker-compose.yml up
CARTULARY_OTEL_ENABLED=false
CARTULARY_ENVIRONMENT=development
OTEL_SERVICE_NAME=cartulary-dev
CARTULARY_EXPERIMENT_NAME=local-dev
CARTULARY_EXPERIMENT_RUN_ID=manual
CARTULARY_RETRIEVAL_VARIANT=poc-baseline
OTEL_EXPORTER_OTLP_PROTOCOL=http_protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Span category controls. Keep HTTP, memory, model, and Oban enabled for normal
# workflow traces. Enable Phoenix/Ecto spans only for deep framework/database
# debugging because they add a lot of low-level spans.
CARTULARY_OTEL_HTTP_SPANS_ENABLED=true
CARTULARY_OTEL_PHOENIX_SPANS_ENABLED=true
CARTULARY_OTEL_MEMORY_SPANS_ENABLED=true
CARTULARY_OTEL_MODEL_SPANS_ENABLED=true
CARTULARY_OTEL_OBAN_SPANS_ENABLED=true
CARTULARY_OTEL_OBAN_SPAN_RELATIONSHIP=child
CARTULARY_OTEL_ECTO_SPANS_ENABLED=false

# Disabled by default because SQL statements can include sensitive values.
CARTULARY_OTEL_DB_STATEMENT_ENABLED=false

# Optional direct-to-Langfuse OTLP config. Prefer the local collector profile
# during development so traces can also be inspected locally.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic <base64-public-key-colon-secret-key>,x-langfuse-ingestion-version=4

# Production-only settings. Not needed for `mix phx.server` in dev.
PHX_HOST=localhost
PHX_SERVER=false
SECRET_KEY_BASE=
DNS_CLUSTER_QUERY=
ECTO_IPV6=false
